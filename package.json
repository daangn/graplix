{
  "name": "@graplix/monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/daangn/graplix.git"
  },
  "license": "MIT",
  "author": "Danggeun Market Inc.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "ultra -r build",
    "build:docs": "yarn workspace @graplix/engine build:docs",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version && yarn install --mode update-lockfile",
    "format": "biome check --fix --unsafe",
    "test": "ultra -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@changesets/cli": "^2.29.8",
    "@types/node": "24.10.13",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "ultra-runner": "^3.10.5"
  },
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "jsonschema@npm:~1.5.0": "patch:jsonschema@npm%3A1.5.0#~/.yarn/patches/jsonschema-npm-1.5.0-a1e4a2d9f7.patch"
  }
}
